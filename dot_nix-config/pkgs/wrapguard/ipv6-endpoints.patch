-// GetInterfaceIP extracts the IP address from the interface address (without CIDR)
+// GetInterfaceIPs extracts all IP addresses from the interface address (supports comma-separated)
+func (c *WireGuardConfig) GetInterfaceIPs() ([]netip.Addr, error) {
+	var addrs []netip.Addr
+	for _, addr := range strings.Split(c.Interface.Address, ",") {
+		addr = strings.TrimSpace(addr)
+		prefix, err := netip.ParsePrefix(addr)
+		if err != nil {
+			return nil, err
+		}
+		addrs = append(addrs, prefix.Addr())
+	}
+	return addrs, nil
+}
+
+// GetInterfaceIP extracts the first IP address from the interface address
 func (c *WireGuardConfig) GetInterfaceIP() (netip.Addr, error) {
-	prefix, err := netip.ParsePrefix(c.Interface.Address)
+	addrs, err := c.GetInterfaceIPs()
 	if err != nil {
 		return netip.Addr{}, err
 	}
-	return prefix.Addr(), nil
+	return addrs[0], nil
 }
 
-// GetInterfacePrefix returns the interface address as a prefix
+// GetInterfacePrefix returns the first interface address as a prefix
 func (c *WireGuardConfig) GetInterfacePrefix() (netip.Prefix, error) {
-	return netip.ParsePrefix(c.Interface.Address)
+	for _, addr := range strings.Split(c.Interface.Address, ",") {
+		addr = strings.TrimSpace(addr)
+		prefix, err := netip.ParsePrefix(addr)
+		if err == nil {
+			return prefix, nil
+		}
+	}
+	return netip.Prefix{}, fmt.Errorf("no valid prefix found in %s", c.Interface.Address)
 }
 
