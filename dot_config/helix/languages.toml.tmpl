{{- $private := fromJson (include "dot_config/helix/languages.private.json") -}}
global-language-servers = ["llama-lsp"]

[[language]]
name = "markdown"
soft-wrap.enable = true

[[language]]
name = "jjdescription"
soft-wrap.enable = true

[[language]]
name = "typescript"
roots = ["deno.json", "deno.jsonc", "package.json"]
language-servers = ["typescript-language-server", "deno-lsp"]

[language.debugger]
command = "js-debug-dap"
name = "js-debug-dap"
transport = "tcp"
port-arg = "{} 127.0.0.1"
quirks = { absolute-paths = true }

[[language.debugger.templates]]
name = "Deno Attach"
request = "attach"
args = { type = "pwa-node", attachSimplePort = "9229" }

[[language]]
name = "tsx"
roots = ["deno.json", "deno.jsonc", "package.json"]
language-servers = ["typescript-language-server", "deno-lsp"]

[language-server.typescript-language-server]
required-root-patterns = ["package.json"]

[language-server.deno-lsp]
command = "deno"
args = ["lsp"]
config = { deno = { enable = true } }
required-root-patterns = ["deno.*"]

[language-server.llama-lsp]
command = "deno"
args = ["run", "-A", "{{ .chezmoi.homeDir }}/Documents/llama.lsp/server.ts", "--stdio"]
[language-server.llama-lsp.config.llamaLsp]
llama_endpoint = "{{ $private.llamaEndpoint }}"
