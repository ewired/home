{
  "sandbox": {
    "extra_binds": [],
    "lift_cargo_path_deps": true,
    "env_filter": "blocklist",
    "env_passthrough": [],
    "env_block": [],
    "git_mode": "off",
    "podman_host_push": true,
    "podman_host_ports": true
