{{- $private := fromJson (include "dot_config/opencode/opencode.private.json") -}}
{
  "autoupdate": false,
  "username": "user",
  "permission": {
    "external_directory": {
      "~/.cache/deno/**": "allow",
      "/nix/store/**": "allow"
    },
    "read": {
      "/nix/store/**": "allow"
    }
  },
  "provider": {{ toPrettyJson $private.provider | trim | replace "\n" "\n  " }},
  "formatter": {
    "prettier": {
      "disabled": true
    }
  },
  "agent": {},
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    }
  },
  "$schema": "https://opencode.ai/config.json"
}
